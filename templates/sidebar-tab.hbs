<header class="ddf-sidebar-header">
  <div class="ddf-sidebar-actions">
    <button type="button" class="ddf-create-faction" title="Create Faction">
      <i class="fa-solid fa-plus"></i> Create Faction
    </button>
    <button type="button" class="ddf-create-folder" title="Create Folder">
      <i class="fa-solid fa-folder-plus"></i> Folder
    </button>
  </div>
  <button type="button" class="ddf-relationships-btn">
    <i class="fa-solid fa-diagram-project"></i> Faction Relationships
  </button>
  <div class="ddf-sidebar-controls">
    <input class="ddf-faction-search" type="search" placeholder="Search Factions…" />
    <button type="button" class="ddf-sort-toggle icon" title="{{#if (eq sortMode 'alpha')}}Alphabetical — click for manual order{{else}}Manual order — click for alphabetical{{/if}}">
      {{#if (eq sortMode "alpha")}}
        <i class="fa-solid fa-arrow-down-a-z"></i>
      {{else}}
        <i class="fa-solid fa-grip-lines"></i>
      {{/if}}
    </button>
  </div>
</header>

<div class="ddf-sidebar-list">

  {{#each sections}}

    {{#if (eq type "folder")}}
      {{> ddf-folder-section this selectedId=../selectedId}}
    {{else}}
      {{!-- Individual unfiled faction at top level --}}
      <ol class="faction-items ddf-unfiled-section" data-folder-id="" data-top-id="{{id}}">
        {{> ddf-faction-item faction=this selectedId=../selectedId}}
      </ol>
    {{/if}}

  {{/each}}

  {{#unless sections.length}}
    <p class="faction-empty ddf-no-factions-hint">
      No factions yet. Click <strong>Create Faction</strong> to get started.
    </p>
  {{/unless}}

</div>
