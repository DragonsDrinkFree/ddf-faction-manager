<div class="global-rel-root">

  <div class="global-rel-layout">

    {{!-- Left Pane: Faction List --}}
    <div class="global-rel-faction-list">
      <div class="global-rel-filter-row">
        <input type="text" class="global-rel-filter-input" placeholder="Filter factions &amp; documents…">
      </div>

      {{!-- Without SCM: all parties at the top --}}
      {{#unless scmPresent}}
        {{#if otherParties.length}}
          <div class="global-rel-list-header"><span>Parties</span></div>
          {{#each otherParties}}
            <div class="global-rel-party-item{{#if isPOV}} selected{{/if}}"
                 data-faction-id="{{id}}" data-filter-name="{{name}}" title="{{name}}">
              <i class="fa-solid fa-people-group fa-fw"></i>
              <span class="global-rel-faction-name">{{name}}</span>
            </div>
          {{/each}}
        {{/if}}
      {{/unless}}

      {{!-- With SCM: active party at the very top --}}
      {{#if scmPresent}}
        {{#if activeParty}}
          <div class="global-rel-list-header"><span>Active Party</span></div>
          <div class="global-rel-party-item{{#if activeParty.isPOV}} selected{{/if}}"
               data-faction-id="{{activeParty.id}}" data-filter-name="{{activeParty.name}}"
               title="{{activeParty.name}}">
            <i class="fa-solid fa-people-group fa-fw"></i>
            <span class="global-rel-faction-name">{{activeParty.name}}</span>
          </div>
        {{/if}}
      {{/if}}

      {{!-- Factions --}}
      <div class="global-rel-list-header">
        <span>Factions</span>
        {{#if povFactionId}}
          <span class="global-rel-pov-hint">Node selected</span>
        {{/if}}
      </div>
      {{#each allFactions}}
        <div class="global-rel-faction-item{{#if isPOV}} selected{{/if}}{{#if isSubFaction}} is-subfaction{{/if}}{{#if isHidden}} is-hidden{{/if}}"
             data-faction-id="{{id}}" data-filter-name="{{name}}"
             title="{{name}}">
          {{#if hasSubFactions}}
            <button type="button" class="global-rel-collapse-btn" data-faction-id="{{id}}"
                    title="{{#if isCollapsed}}Expand{{else}}Collapse{{/if}} sub-factions">
              <i class="fa-solid fa-chevron-{{#if isCollapsed}}right{{else}}down{{/if}}"></i>
            </button>
          {{else}}
            <span class="global-rel-indent-spacer"></span>
          {{/if}}
          <i class="fa-solid fa-shield-halved"></i>
          <span class="global-rel-faction-name">{{name}}</span>
        </div>
      {{else}}
        <div class="global-rel-empty">No factions yet.</div>
      {{/each}}

      {{!-- With SCM: other parties below factions --}}
      {{#if scmPresent}}
        {{#if otherParties.length}}
          <div class="global-rel-list-header"><span>Other Parties</span></div>
          {{#each otherParties}}
            <div class="global-rel-party-item{{#if isPOV}} selected{{/if}}"
                 data-faction-id="{{id}}" data-filter-name="{{name}}" title="{{name}}">
              <i class="fa-solid fa-people-group fa-fw"></i>
              <span class="global-rel-faction-name">{{name}}</span>
            </div>
          {{/each}}
        {{/if}}
      {{/if}}

      {{!-- Documents section --}}
      <div class="global-rel-section-header">
        <span>Documents</span>
        <button type="button" class="icon" data-action="addDocument" title="Add document to map">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      {{#if mapDocuments.length}}
        {{#each mapDocuments}}
          <div class="global-rel-doc-item{{#if isSelected}} selected{{/if}}"
               data-uuid="{{uuid}}" data-filter-name="{{documentName}}" title="{{documentName}}">
            <i class="fa-solid {{icon}} fa-fw"></i>
            <span class="global-rel-doc-name">{{documentName}}</span>
            <button type="button" class="global-rel-doc-remove icon"
                    data-action="removeDocument" data-uuid="{{uuid}}" title="Remove from map">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{/each}}
      {{else}}
        <div class="global-rel-empty global-rel-doc-empty">
          No documents. Click <i class="fa-solid fa-plus"></i> or drag a document onto the canvas.
        </div>
      {{/if}}

    </div>

    {{!-- Right Pane: SVG Canvas --}}
    <div class="relationship-canvas-wrap"></div>

  </div>

  <div class="relationship-hint">
    Click node to select &nbsp;&middot;&nbsp;
    Right-click canvas to add connection &nbsp;&middot;&nbsp;
    Drag node to reposition &nbsp;&middot;&nbsp;
    Drag canvas to pan &nbsp;&middot;&nbsp; Scroll to zoom
  </div>

</div>
